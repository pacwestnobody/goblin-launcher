<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The librarian's self-signed certificate is accepted by SHA-256 pin in the app
     (GoblinApi), never via user-added CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
